// TEST FIXTURE ONLY. A copy of console-api's schema, used to stand in for
// Console in the e2e harness (workspaces, projects and environments are seeded
// here). The Auth app never imports it. See e2e/support/fixtures.ts.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Shipstack Users ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  password  String?
  googleId  String?  @unique @map("google_id")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  memberships   WorkspaceMembership[]
  refreshTokens UserRefreshToken[]

  @@map("users")
}

model UserRefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_refresh_tokens")
}

// ─── Workspaces ───────────────────────────────────────────────────────────────
// A workspace owns projects and has members with roles.
// Every user gets a default personal workspace on signup.
// Users can create additional workspaces and invite collaborators.

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  WorkspaceMembership[]
  projects Project[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  userId      String          @map("user_id")
  role        WorkspaceRole   @default(MEMBER)
  createdAt   DateTime        @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_memberships")
}

// ─── Projects ─────────────────────────────────────────────────────────────────
// Projects belong to a workspace, not a user directly.

model Project {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  mode        ProjectMode @default(B2C)
  createdAt   DateTime    @default(now()) @map("created_at")

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile      ProjectProfile?
  environments Environment[]

  @@index([workspaceId])
  @@map("projects")
}

model ProjectProfile {
  id           String   @id @default(uuid())
  projectId    String   @unique @map("project_id")
  name         String
  supportEmail String?  @map("support_email")
  logoUrl      String?  @map("logo_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_profiles")
}

// ─── Environments ─────────────────────────────────────────────────────────────

model Environment {
  id                   String            @id @default(uuid())
  projectId            String            @map("project_id")
  name                 String
  type                 EnvironmentType
  slug                 String            @unique
  publishableKey       String            @unique @map("publishable_key")
  jwtPublicKey         String            @map("jwt_public_key")
  jwtPrivateKey        String            @map("jwt_private_key")
  secretKey            String            @map("secret_key")
  secretKeyEncrypted   String            @map("secret_key_encrypted")
  accessTokenTtl             Int               @default(900) @map("access_token_ttl")
  refreshTokenTtl            Int               @default(604800) @map("refresh_token_ttl")
  requireEmailVerification   Boolean           @default(false) @map("require_email_verification")
  minPasswordLength          Int               @default(8) @map("min_password_length")
  passwordRequirements       String            @default("letters_digits") @map("password_requirements")
  collectFirstLastName       Boolean           @default(true) @map("collect_first_last_name")
  requireFirstLastName       Boolean           @default(false) @map("require_first_last_name")
  allowSelfDeletion          Boolean           @default(true) @map("allow_self_deletion")
  preventLeakedPasswords     Boolean           @default(false) @map("prevent_leaked_passwords")
  minPasswordStrength        Int?              @map("min_password_strength")
  status                     EnvironmentStatus @default(ACTIVE)
  allowedOrigins       String[]          @default([]) @map("allowed_origins")
  createdAt             DateTime          @default(now()) @map("created_at")

  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  oauthConfigs      OAuthProviderConfig[]
  authMethodConfigs AuthMethodConfig[]
  features          Feature[]
  quotas            Quota[]
  plans             Plan[]
  subscriptions     Subscription[]

  @@unique([projectId, type])
  @@map("environments")
}

// ─── OAuth Provider Configs ───────────────────────────────────────────────────

model OAuthProviderConfig {
  id                   String        @id @default(uuid())
  environmentId        String        @map("environment_id")
  provider             OAuthProvider
  useCustomCredentials Boolean       @default(false) @map("use_custom_credentials")
  providerClientId     String?       @map("provider_client_id")
  providerClientSecret String?       @map("provider_client_secret")
  createdAt            DateTime      @default(now()) @map("created_at")

  environment   Environment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  callbackUrls  OAuthCallbackUrl[]

  @@unique([environmentId, provider])
  @@map("oauth_provider_configs")
}

model OAuthCallbackUrl {
  id            String        @id @default(uuid())
  environmentId String        @map("environment_id")
  provider      OAuthProvider
  url           String
  createdAt     DateTime      @default(now()) @map("created_at")

  config OAuthProviderConfig @relation(fields: [environmentId, provider], references: [environmentId, provider], onDelete: Cascade)

  @@map("oauth_callback_urls")
}

// ─── Auth Method Configs ──────────────────────────────────────────────────────
// Single source of truth for all auth method toggles per environment.
// OAuth credentials remain in OAuthProviderConfig (separate concern).

model AuthMethodConfig {
  id            String     @id @default(uuid())
  environmentId String     @map("environment_id")
  method        AuthMethod
  enabled       Boolean    @default(true)

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, method])
  @@map("auth_method_configs")
}

// ─── Features ─────────────────────────────────────────────────────────────────
// Standalone feature flag registry per environment.
// Bit positions are assigned once and recycled 1hr after retirement.

model Feature {
  id            String    @id @default(uuid())
  environmentId String    @map("environment_id")
  name          String
  key           String
  bitPosition     Int       @map("bit_position")
  description     String?
  defaultEnabled  Boolean   @default(false) @map("default_enabled")
  retiredAt       DateTime? @map("retired_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  environment  Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  entitlements Entitlement[]

  @@unique([environmentId, key])
  @@index([environmentId, bitPosition])
  @@map("features")
}

// ─── Quota ────────────────────────────────────────────────────────────────────
// Standalone quota resource registry per environment.

model Quota {
  id             String    @id @default(uuid())
  environmentId  String    @map("environment_id")
  name           String
  key            String
  type           QuotaType
  parentKey      String?   @map("parent_key")
  position       Int
  defaultLimit   Int       @default(0) @map("default_limit")
  defaultPeriod  String?   @map("default_period")
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at")

  environment      Environment                 @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  planQuotas       PlanQuota[]
  quotaOverrides   SubscriptionQuotaOverride[]

  @@unique([environmentId, key])
  @@unique([environmentId, parentKey, position])
  @@map("quota")
}

// ─── Plans ────────────────────────────────────────────────────────────────────
// Standalone plan definitions. Composed of features (as entitlements) and quota.
// Entitlements and quota limits define what each plan grants.

model Plan {
  id            String   @id @default(uuid())
  environmentId String   @map("environment_id")
  key           String
  name          String
  description   String?
  isDefault     Boolean  @default(false) @map("is_default")
  entBitfield   String   @default("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA") @map("ent_bitfield")
  createdAt     DateTime @default(now()) @map("created_at")

  environment   Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  entitlements  Entitlement[]
  planQuotas    PlanQuota[]
  subscriptions Subscription[]

  @@unique([environmentId, key])
  @@map("plans")
}

// ─── Entitlements ─────────────────────────────────────────────────────────────
// A feature granted to a plan. This is where a feature becomes an entitlement.

model Entitlement {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  featureId String   @map("feature_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("entitlements")
}

// ─── Plan Quota ───────────────────────────────────────────────────────────────
// Assigns quota limits to a plan.

model PlanQuota {
  id          String       @id @default(uuid())
  planId      String       @map("plan_id")
  quotaId     String       @map("quota_id")
  limit       Int
  period      QuotaPeriod?
  rollover    Boolean      @default(false)
  rolloverCap Int?         @map("rollover_cap")
  adjustable  Boolean      @default(false)
  steps       Int[]        @default([])
  stepPrices  Int[]        @default([]) @map("step_prices")
  createdAt   DateTime     @default(now()) @map("created_at")

  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  quota Quota @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@unique([planId, quotaId])
  @@map("plan_quota")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────
// Links an identity to a plan. Managed by developer via console-api.
// Platform-api reads this to resolve entitlements at token mint time.
// Trials are subscriptions with expires_at set.

model Subscription {
  id             String    @id @default(uuid())
  environmentId  String    @map("environment_id")
  identityId     String    @map("identity_id")
  planId         String    @map("plan_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  status                 String    @default("ACTIVE")

  environment      Environment                 @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  plan             Plan                        @relation(fields: [planId], references: [id])
  quotaOverrides   SubscriptionQuotaOverride[]

  @@unique([environmentId, identityId])
  @@index([environmentId, identityId])
  @@map("subscriptions")
}

// ─── Subscription Quota Overrides ─────────────────────────────────────────────
// Stores the step the user selected for each adjustable quota on their subscription.

model SubscriptionQuotaOverride {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  quotaId        String   @map("quota_id")
  selectedStep   Int      @map("selected_step")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  quota        Quota        @relation(fields: [quotaId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, quotaId])
  @@map("subscription_quota_overrides")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER

}

enum ProjectMode {
  B2C
  B2B

}

enum EnvironmentType {
  DEVELOPMENT
  PRODUCTION

}

enum EnvironmentStatus {
  ACTIVE
  SUSPENDED

}

enum AuthMethod {
  EMAIL_PASSWORD
  MAGIC_LINK
  EMAIL_CODE
  PASSKEY
  GOOGLE
  GITHUB
  APPLE
  MICROSOFT
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  APPLE
  MICROSOFT
}

enum QuotaType {
  CAPACITY
  RATE

}

enum QuotaPeriod {
  DAY
  MONTH
  LIFETIME

}

