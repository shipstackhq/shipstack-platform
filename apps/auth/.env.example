# Copy to .env and fill in. Never commit .env.
# Values below are local-development defaults that match `docker run postgres:16`.

PORT=9001
BASE_URL="http://localhost:9001"

# Auth's own tables (sessions, identities, attempts, outbox).
PLATFORM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipstack?schema=platform"

# Console's tables, read-only. Auth reads the environment and auth-method
# configuration from here and never writes to it.
CONSOLE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipstack?schema=console"

# 32 bytes as 64 hex characters, e.g. `openssl rand -hex 32`.
ENCRYPTION_KEY=

# Signs the __client cookie. Any long random string, e.g. `openssl rand -hex 32`.
CLIENT_COOKIE_SECRET=

# Optional. Without SMTP_HOST, emails are written to the log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@shipstack.run

# Platform-owned Google OAuth app, used for environments that don't bring their own.
DEFAULT_GOOGLE_CLIENT_ID=
DEFAULT_GOOGLE_CLIENT_SECRET=
