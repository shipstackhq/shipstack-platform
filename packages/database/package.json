{
  "name": "@shipstack/database",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema=prisma/platform.prisma && prisma generate --schema=prisma/console.prisma",
    "generate:platform": "prisma generate --schema=prisma/platform.prisma",
    "generate:console": "prisma generate --schema=prisma/console.prisma",
    "build": "pnpm generate",
    "clean": "rm -rf src/generated"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "typescript": "^5.7.3"
  }
}
